// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  books    Book[]
}

model Book {
  id       String @id @default(cuid())
  title    String
  author   String
  genre    String?
  coverUrl String?
  isbn     String?
  ownerId  String
  owner    User   @relation(fields: [ownerId], references: [id])
  loans    Loan[]
}

model Loan {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id])
  borrowerName String
  dateLent     DateTime
  dueDate      DateTime
  returnedAt   DateTime?
}